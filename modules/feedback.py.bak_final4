import pandas as pd
import yfinance as yf
from datetime import datetime, timedelta
import time
import logging
import sys
import os

# Adicionar caminho para importar módulos do projeto
sys.path.append(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

class FeedbackRecorder:
    def __init__(self, csv_path='data/feedback.csv'):
        self.csv_path = csv_path
        self.df = None
        self._load()

    def _load(self):
        try:
            self.df = pd.read_csv(self.csv_path)
        except FileNotFoundError:
            self.df = pd.DataFrame(columns=[
                'timestamp', 'asset', 'timeframe', 'direction',
                'entry_price', 'exit_price', 'result', 'score_buy',
                'score_sell', 'mq', 'atr', 'bollinger_width', 'adx'
            ])

    def _save(self):
        self.df.to_csv(self.csv_path, index=False)

    def confirmar_trade(self, asset, direction, entry_price, timestamp,
                         timeframe_min=5, timeout_min=6):
        """
        Confirma um trade usando IQ Option como fonte primária.
        Se falhar, usa yfinance como fallback.
        Retorna 'WIN' ou 'LOSS' e o preço de saída.
        """
        # Formatar ativo para yfinance
        yf_asset = asset.replace('=', '').replace('X', '')
        if yf_asset.endswith('=X'):
            yf_asset = yf_asset[:-2]

        # 1. Tentar via IQ Option
        try:
            # Tenta importar o módulo connector dinamicamente (se existir)
            try:
                from modules.connector import get_iq_option
                iq = get_iq_option()
            except ImportError:
                iq = None
                logging.warning("Módulo connector não encontrado. A usar apenas yfinance.")
            
            if iq is not None:
                candles = iq.get_candles(asset, timeframe_min, 2)
                if candles and len(candles) >= 2:
                    exit_price = candles[1]['close']
                    if direction == 'COMPRA':
                        result = 'WIN' if exit_price > entry_price else 'LOSS'
                    else:
                        result = 'WIN' if exit_price < entry_price else 'LOSS'
                    self._registrar(asset, timestamp, timeframe_min, direction,
                                   entry_price, exit_price, result)
                    return result, exit_price
        except Exception as e:
            logging.warning(f"IQ Option falhou: {e}. A usar fallback yfinance.")

        # 2. Fallback: yfinance
        try:
            # Calcular o intervalo de tempo para o candle de saída
            entry_dt = datetime.fromtimestamp(timestamp)
            start_dt = entry_dt + timedelta(minutes=timeframe_min)
            end_dt = start_dt + timedelta(minutes=timeframe_min)

            # Baixar dados
            data = yf.download(yf_asset, start=start_dt, end=end_dt, interval=f'{timeframe_min}m', progress=False)
            if not data.empty:
                exit_price = data['Close'].iloc[-1]
                if direction == 'COMPRA':
                    result = 'WIN' if exit_price > entry_price else 'LOSS'
                else:
                    result = 'WIN' if exit_price < entry_price else 'LOSS'
                self._registrar(asset, timestamp, timeframe_min, direction,
                               entry_price, exit_price, result)
                return result, exit_price
            else:
                logging.error(f"yfinance não retornou dados para {yf_asset} no período.")
        except Exception as e:
            logging.error(f"Fallback yfinance também falhou: {e}")

        # Se tudo falhar, registar como LOSS por segurança
        logging.warning("Confirmação impossível. Registando como LOSS.")
        result = 'LOSS'
        exit_price = entry_price
        self._registrar(asset, timestamp, timeframe_min, direction,
                       entry_price, exit_price, result)
        return result, exit_price

    def _registrar(self, asset, timestamp, timeframe, direction,
                   entry_price, exit_price, result):
        novo = pd.DataFrame([{
            'timestamp': timestamp,
            'asset': asset,
            'timeframe': timeframe,
            'direction': direction,
            'entry_price': entry_price,
            'exit_price': exit_price,
            'result': result,
            'score_buy': 0,
            'score_sell': 0,
            'mq': 0,
            'atr': 0,
            'bollinger_width': 0,
            'adx': 0
        }])
        self.df = pd.concat([self.df, novo], ignore_index=True)
        self._save()

    def ultimo_trade(self):
        if self.df.empty:
            return None
        return self.df.iloc[-1].to_dict()
