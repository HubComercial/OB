import sqlite3
from datetime import datetime

class Brain:

    def __init__(self, db="learning.db"):
        self.conn = sqlite3.connect(db)
        self.conn.execute("""
        CREATE TABLE IF NOT EXISTS trades(
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            asset TEXT,
            direction TEXT,
            timeframe INTEGER,
            confidence REAL,
            market_quality REAL,
            result TEXT,
            profit REAL,
            created_at TEXT
        )
        """)
        self.conn.commit()

    def save(self,
             asset,
             direction,
             timeframe,
             confidence,
             market_quality,
             result,
             profit):

        self.conn.execute("""
        INSERT INTO trades(
            asset,
            direction,
            timeframe,
            confidence,
            market_quality,
            result,
            profit,
            created_at
        )
        VALUES(?,?,?,?,?,?,?,?)
        """,(
            asset,
            direction,
            timeframe,
            confidence,
            market_quality,
            result,
            profit,
            datetime.utcnow().isoformat()
        ))

        self.conn.commit()
